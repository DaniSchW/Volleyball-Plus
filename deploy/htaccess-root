# Lies in the folder the domain points to (next to backend/). Forwards every
# request into backend/public, so .env, vendor/, storage/ etc. are never
# reachable – the package can be unzipped directly into the domain folder.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Certificate checks (Let's Encrypt) stay reachable over plain HTTP.
    RewriteRule ^\.well-known/acme-challenge/ - [L]

    # Never serve anything over plain HTTP.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteCond %{REQUEST_URI} !^/backend/public/
    RewriteRule ^(.*)$ backend/public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
